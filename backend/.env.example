# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key-in-production

# Database configuration
# Set this to your cloud Postgres URL (e.g. from Neon.tech or Supabase)
DATABASE_URL=postgresql://postgres:secret@localhost:5432/jobsphere

# Worker configuration
# Defines the worker identifier (host/process info)
WORKER_NAME=dev-worker-1
# Maximum concurrent jobs executed by this worker instance globally across all queues
MAX_WORKER_CONCURRENCY=10
# Interval (in seconds) that the worker polls the database for new jobs
POLL_INTERVAL=1.0
# Heartbeat interval (in seconds) for worker health status
HEARTBEAT_INTERVAL=5.0
